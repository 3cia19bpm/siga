+    }
+
+    function atualizarEspelhoDataR96(input) {
+      if (!input || !input.dataset.r96Date) return;
+      const wrapper = input.closest('.siga-date-field-r96');
+      if (!wrapper) return;
+      const display = wrapper.querySelector('.siga-date-display-r96');
+      if (!display) return;
+      const br = dataIsoParaBrR96(input.value);
+      display.textContent = br || 'dd/mm/aaaa';
+      wrapper.classList.toggle('is-empty', !br);
+      wrapper.classList.toggle('is-disabled', !!input.disabled);
+    }
+
+    function aprimorarInputDateR96(input) {
+      if (!input || input.dataset.r96Date || input.classList.contains('siga-date-picker-aux-r96')) return;
+      const pai = input.parentNode;
+      if (!pai) return;
+      const wrapper = document.createElement('span');
+      wrapper.className = 'siga-date-field-r96';
+      const display = document.createElement('span');
+      display.className = 'siga-date-display-r96';
+      display.setAttribute('aria-hidden','true');
+      const icone = document.createElement('span');
+      icone.className = 'siga-date-calendar-r96';
+      icone.setAttribute('aria-hidden','true');
+      icone.innerHTML = iconeCalendarioR96();
+      pai.insertBefore(wrapper, input);
+      wrapper.appendChild(display);
+      wrapper.appendChild(input);
+      wrapper.appendChild(icone);
+      input.dataset.r96Date = '1';
+      input.classList.add('siga-date-native-r96');
+      input.addEventListener('input', function(){ atualizarEspelhoDataR96(input); });
+      input.addEventListener('change', function(){ atualizarEspelhoDataR96(input); });
+      atualizarEspelhoDataR96(input);
+    }
+
+    function aprimorarFiltroDataPermutasR96() {
+      const campo = document.getElementById('dataPermutasAdmin');
+      if (!campo || campo.dataset.r96Calendar) return;
+      const pai = campo.parentNode;
+      if (!pai) return;
+      const wrapper = document.createElement('span');
+      wrapper.className = 'siga-date-filter-r96';
+      pai.insertBefore(wrapper, campo);
